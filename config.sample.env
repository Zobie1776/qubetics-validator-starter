# Copy to .env and adjust values for your deployment

# Base network configuration
NETWORK_PROFILE=mainnet             # mainnet or testnet
CHAIN_ID=qubetics-1                 # Cosmos SDK chain-id
MONIKER=NovaOS-1                    # Default validator moniker
MIN_TICS=25000                      # Minimum self delegation in display units
P2P_PORT=26656
RPC_PORT=26657
GRPC_PORT=9090
API_PORT=1317
PROMETHEUS_PORT=26660

# Validator credentials
KEY_NAME=validator
KEYRING_BACKEND=file
HOME_DIR=/data/.qubeticsd

# RPC exposure controls
ALLOW_IPS=1.2.3.4,5.6.7.8
DOMAIN=rpc.example.com
EMAIL=admin@example.com
RATE_LIMIT_RPS=5

# Logging and metrics
LOG_LEVEL=info
METRICS_ENABLED=true
METRICS_LISTEN_ADDR=0.0.0.0:9300

# Snapshot/backup
SNAPSHOT_DIR=/var/backups/qubetics/snapshots
SNAPSHOT_RETAIN=5
BACKUP_DIR=/var/backups/qubetics/archives
BACKUP_PASSPHRASE=

# Monitoring thresholds
BLOCK_LAG_THRESHOLD=20
PEER_MINIMUM=8
DISK_WARN_GB=20
MEMORY_WARN_PERCENT=85
CPU_WARN_PERCENT=85
REFERENCE_RPC=https://rpc.qubetics.org
PEERS=

# Alerts
TELEGRAM_BOT_TOKEN=changeme
TELEGRAM_CHAT_ID=changeme
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/.../...

# Docker registry
DOCKER_REGISTRY=ghcr.io/qubetics
DOCKER_IMAGE=q-sync-validator
DOCKER_TAG=latest

# Infrastructure
CLOUD_PROVIDER=aws
AWS_PROFILE=qubetics
AWS_REGION=us-east-1

# Release automation
GIT_MAIN_BRANCH=main
